# CCC agent stack (vps/agent-stack). install-agent-stack.sh creates .env from this
# file and generates the secrets. NEVER commit .env.

# Docker bridge gateway IP. Run: ip -4 -o addr show docker0   (usually 172.17.0.1)
BRIDGE_IP=172.17.0.1

# Gateway master key -- paste this into OpenHands as the API key.
LITELLM_MASTER_KEY=

# SearXNG secret key.
SEARXNG_SECRET=

# Optional shared secret between LiteLLM and the Kaggle llama-server. If you set it here,
# also add it as the Kaggle notebook secret LLM_API_KEY. "local" = no auth on llama-server.
KAGGLE_LLM_API_KEY=local

# Key for the paid models behind ccc-client / ccc-fast (client work, optional fallback).
# Copied from the workspace .env by the installer if present. To change which Claude
# model those aliases use, edit litellm_config.yaml.
ANTHROPIC_API_KEY=

# Image tags. Pin these to exact versions after your first successful run.
LITELLM_TAG=main-stable
SEARXNG_TAG=latest
OPENHANDS_TAG=1.8
AGENT_SERVER_TAG=1.26.0-python

# OpenHands state (settings, conversations) lives here.
OPENHANDS_STATE_DIR=/opt/coding-workspace/openhands
