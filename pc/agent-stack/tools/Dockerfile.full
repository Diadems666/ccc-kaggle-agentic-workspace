FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ripgrep nodejs npm build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir pytest pytest-cov ruff mypy debugpy
COPY ccc_tools_server.py fs_tools.py memory_tools.py exec_tools.py ./
RUN git config --system user.name "CCC Agent" && git config --system user.email "agent@cairnscustomcomputers.invalid" \
    && git config --system --add safe.directory '*'
EXPOSE 8765
CMD ["python", "ccc_tools_server.py"]
